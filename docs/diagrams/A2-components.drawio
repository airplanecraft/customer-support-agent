Point x="1320" y="985"/><mxPoint x="1520" y="985"/></Array></mxGeometry></mxCell><mxCell id="c74" value="LLMOps plane — Git is the source of truth; the pipeline is the only writer to Langfuse" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;opacity=60;strokeColor=#E8590C;strokeWidth=3;" vertex="1" parent="1" ><mxGeometry x="20" y="1340" width="1880" height="220" as="geometry"/></mxCell><mxCell id="c75" value="&lt;b&gt;Git&lt;/b&gt;&lt;br&gt;prompts · models.yaml · evaluators&lt;br&gt;judge prompts · datasets · release.yaml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="60" y="1390" width="270" height="80" as="geometry"/></mxCell><mxCell id="c76" value="&lt;b&gt;CI / CD pipeline&lt;/b&gt;&lt;br&gt;sync → evaluate → gate →&lt;br&gt;label → deploy → canary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="380" y="1390" width="240" height="80" as="geometry"/></mxCell><mxCell id="c77" value="&lt;b&gt;Langfuse (self-hosted)&lt;/b&gt;&lt;br&gt;prompt versions + config · datasets / experiments&lt;br&gt;LLM-as-judge evaluators · traces · annotation queues" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="680" y="1380" width="380" height="100" as="geometry"/></mxCell><mxCell id="c78" value="&lt;b&gt;Rule-eval service&lt;/b&gt;&lt;br&gt;deterministic checks on traces&lt;br&gt;(same code as guardrails)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1110" y="1390" width="240" height="80" as="geometry"/></mxCell><mxCell id="c79" value="&lt;b&gt;Model registry&lt;/b&gt;&lt;br&gt;models.yaml (hash, licence, eval, approval)&lt;br&gt;weights in object storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1400" y="1390" width="270" height="80" as="geometry"/></mxCell><mxCell id="c80" value="&lt;b&gt;Test harness&lt;/b&gt;&lt;br&gt;user simulator · mock core&lt;br&gt;systems · SIP sim · red team" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1700" y="1390" width="180" height="80" as="geometry"/></mxCell><mxCell id="c81" value="PR merged" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c75" target="c76"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c82" value="push versions · labels" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c76" target="c77"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c83" value="traces" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;startArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c77" target="c78"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c84" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8590C;strokeColor=#E8590C;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1" ><mxGeometry x="67" y="192" width="26" height="26" as="geometry"/></mxCell><mxCell id="c85" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8590C;strokeColor=#E8590C;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1" ><mxGeometry x="747" y="1017" width="26" height="26" as="geometry"/></mxCell><mxCell id="c86" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8590C;strokeColor=#E8590C;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1" ><mxGeometry x="687" y="457" width="26" height="26" as="geometry"/></mxCell><mxCell id="c87" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8590C;strokeColor=#E8590C;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1" ><mxGeometry x="47" y="477" width="26" height="26" as="geometry"/></mxCell><mxCell id="c88" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8590C;strokeColor=#E8590C;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1" ><mxGeometry x="47" y="637" width="26" height="26" as="geometry"/></mxCell><mxCell id="c89" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8590C;strokeColor=#E8590C;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1" ><mxGeometry x="727" y="357" width="26" height="26" as="geometry"/></mxCell><mxCell id="c90" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8590C;strokeColor=#E8590C;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1" ><mxGeometry x="1047" y="457" width="26" height="26" as="geometry"/></mxCell><mxCell id="c91" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8590C;strokeColor=#E8590C;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1" ><mxGeometry x="357" y="677" width="26" height="26" as="geometry"/></mxCell><mxCell id="c92" value="9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E8590C;strokeColor=#E8590C;fontColor=#ffffff;fontStyle=1;fontSize=13;" vertex="1" parent="1" ><mxGeometry x="7" y="1327" width="26" height="26" as="geometry"/></mxCell><mxCell id="c93" value="&lt;b&gt;Design highlights&lt;/b&gt;&lt;br&gt;&lt;b&gt;1 External API gateway&lt;/b&gt; — the only way in for app, web and staff traffic: WAF, JWT check, rate limits (client's Apigee / Kong)&lt;br&gt;&lt;b&gt;2 Internal API gateway&lt;/b&gt; — the only way to systems of record; each MCP server has its own client cert and reaches only its own APIs&lt;br&gt;&lt;b&gt;3 MCP servers&lt;/b&gt; — our tool layer over the client's APIs: the LLM never sees raw APIs; customer identity comes from the token; changes are drafts only&lt;br&gt;&lt;b&gt;4 RAG service&lt;/b&gt; — hybrid search (vector + BM25), rerank, version-correct clauses, a citation check on every sentence&lt;br&gt;&lt;b&gt;5 Model gateway&lt;/b&gt; — the only way to any model: routes between Bailian and vLLM, quotas, cost per channel, fallback to a smaller model&lt;br&gt;&lt;b&gt;6 Token store&lt;/b&gt; — tokens never enter agent state or prompts; agents carry only an auth_ref&lt;br&gt;&lt;b&gt;7 Approval service&lt;/b&gt; — AI drafts, humans approve; separation of duties before anything takes effect&lt;br&gt;&lt;b&gt;8 Guardrail library&lt;/b&gt; — the same rule code runs live and in offline evaluation&lt;br&gt;&lt;b&gt;9 LLMOps plane&lt;/b&gt; — prompts, models, evaluators and datasets versioned in Git; the pipeline gates every release" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;align=left;spacingLeft=12;fontSize=11;strokeColor=#E8590C;strokeWidth=2;" vertex="1" parent="1" ><mxGeometry x="20" y="1155" width="1300" height="170" as="geometry"/></mxCell><mxCell id="c94" value='&lt;b&gt;Key paths&lt;/b&gt;&lt;br&gt;&lt;font color="#2B8A3E"&gt;━━━&lt;/font&gt; channels → external API gateway → orchestrator&lt;br&gt;&lt;font color="#C92A2A"&gt;━━━&lt;/font&gt; orchestrator → MCP → internal API gateway → systems of record&lt;br&gt;&lt;font color="#1971C2"&gt;━━━&lt;/font&gt; orchestrator / RAG → model gateway → Bailian or vLLM' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;align=left;spacingLeft=12;fontSize=12;strokeColor=#E8590C;strokeWidth=2;" vertex="1" parent="1" ><mxGeometry x="1340" y="1155" width="560" height="170" as="geometry"/></mxCell><mxCell id="c95" value="Runtime: orchestrator reads prompts by release label (cache + image-baked fallback) · all LLM calls traced to Langfuse · judges call the model gateway (no external APIs)" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1" ><mxGeometry x="60" y="1490" width="1000" height="45" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
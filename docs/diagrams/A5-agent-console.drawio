<mxfile host="drawio"><diagram name="A5 Agent Console" id="d1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="A5 · Agent console — what a human agent sees after handoff (embedded in the Genesys agent desktop)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1" ><mxGeometry x="40" y="10" width="1400" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Agent console · staff SSO + MFA · roles: cs_agent / supervisor / approver / qa / compliance · data only for interactions assigned to this agent" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;opacity=60;" vertex="1" parent="1" ><mxGeometry x="20" y="50" width="1460" height="900" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Header&lt;/b&gt; · customer (masked) · &lt;b&gt;verified by AI 10:02 (voice_otp_dob)&lt;/b&gt; · handoff reason · sentiment · language · channel · wait time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="40" y="90" width="1420" height="50" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;1 · Handoff summary&lt;/b&gt; &lt;i&gt;(AI-generated, marked)&lt;/i&gt;&lt;br&gt;3 lines, fixed schema&lt;br&gt;intent(s) · why handed off · what the customer wants next" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="40" y="160" width="460" height="130" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;2 · Full bot transcript&lt;/b&gt;&lt;br&gt;chat text · voice STT transcript with confidence&lt;br&gt;redacted · DTMF never shown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="40" y="310" width="460" height="300" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;3 · AI answers and citations&lt;/b&gt;&lt;br&gt;each answer with clause ID + version&lt;br&gt;click → clause text of that version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="520" y="160" width="460" height="220" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;4 · Tool-call timeline&lt;/b&gt;&lt;br&gt;tool · arguments (masked) · result · time&lt;br&gt;guardrail events (refusals, step-ups)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="520" y="400" width="460" height="210" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;5 · Open tasks and drafts&lt;/b&gt;&lt;br&gt;from the task table (system facts)&lt;br&gt;status · pending approvals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1000" y="160" width="460" height="150" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;6 · Customer overview&lt;/b&gt;&lt;br&gt;from CRM · masked per role&lt;br&gt;accounts · recent orders · flags" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1000" y="330" width="460" height="140" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;7 · Knowledge search&lt;/b&gt;&lt;br&gt;same hybrid RAG&lt;br&gt;+ internal-visibility articles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1000" y="490" width="460" height="120" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;8 · Actions and wrap-up&lt;/b&gt; (per role)&lt;br&gt;create / update tasks · approvals go to the approver queue (never own drafts)&lt;br&gt;wrap-up notes drafted by AI → agent edits → CRM · disposition code&lt;br&gt;&lt;b&gt;feedback on the AI&lt;/b&gt;: right / wrong + reason code → annotation queue → golden set" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="40" y="630" width="1420" height="120" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Facts vs summary&lt;/b&gt;: verification, tasks, tool calls and citations come from system records;&lt;br&gt;only the 3-line summary is written by the LLM, and it is labelled as AI-generated." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1" ><mxGeometry x="40" y="770" width="700" height="70" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Console hardening&lt;/b&gt;: every view audited (who, what, when) · no PII in URLs ·&lt;br&gt;export / copy limited · CSP · idle timeout · access revoked 30 min after wrap-up" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1" ><mxGeometry x="760" y="770" width="700" height="70" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Supervisor view&lt;/b&gt;&lt;br&gt;live queues and wait times&lt;br&gt;&lt;b&gt;monitor live AI chats&lt;/b&gt;&lt;br&gt;take over a chat at any time&lt;br&gt;handoff reasons by intent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1520" y="90" width="350" height="220" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Phase 2 · Agent assist&lt;/b&gt;&lt;br&gt;suggested replies · next best action&lt;br&gt;auto wrap-up notes&lt;br&gt;&lt;b&gt;the agent decides; the AI never&lt;br&gt;sends on the agent's behalf&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1520" y="340" width="350" height="200" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;No hand-back&lt;/b&gt;&lt;br&gt;once a human takes over,&lt;br&gt;the conversation stays human&lt;br&gt;until it ends" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1520" y="570" width="350" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
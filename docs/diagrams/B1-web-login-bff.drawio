assword + OTP / passkey)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" ><mxGeometry relative="1" as="geometry"><mxPoint x="115.0" y="402" as="sourcePoint"/><mxPoint x="685.0" y="402" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="302 → /callback?code, state" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;dashed=1;" edge="1" parent="1" ><mxGeometry relative="1" as="geometry"><mxPoint x="685.0" y="444" as="sourcePoint"/><mxPoint x="305.0" y="444" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value="GET /callback?code, state" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" ><mxGeometry relative="1" as="geometry"><mxPoint x="305.0" y="486" as="sourcePoint"/><mxPoint x="495.0" y="486" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="check state == stored state (CSRF)" style="html=1;align=left;spacingLeft=44;fontSize=10;endArrow=block;" edge="1" parent="1" ><mxGeometry relative="1" as="geometry"><mxPoint x="495.0" y="528" as="sourcePoint"/><mxPoint x="495.0" y="546" as="targetPoint"/><Array as="points"><mxPoint x="535.0" y="528"/><mxPoint x="535.0" y="546"/></Array></mxGeometry></mxCell><mxCell id="c11" value="POST /token (code + code_verifier + client auth)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" ><mxGeometry relative="1" as="geometry"><mxPoint x="495.0" y="580" as="sourcePoint"/><mxPoint x="685.0" y="580" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="id_token + access_token + refresh_token" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;dashed=1;" edge="1" parent="1" ><mxGeometry relative="1" as="geometry"><mxPoint x="685.0" y="622" as="sourcePoint"/><mxPoint x="495.0" y="622" as="targetPoint"/></mxGeometry></mxCell><mxCell 
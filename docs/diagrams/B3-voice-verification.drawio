<mxfile host="drawio"><diagram name="B3 Voice verification" id="d1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1032" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ll_ts" value="Token store" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1370" y="60" width="150" height="932" as="geometry"/></mxCell><mxCell id="ll_idp" value="IdP" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="60" width="150" height="932" as="geometry"/></mxCell><mxCell id="ll_sms" value="SMS gateway" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="60" width="150" height="932" as="geometry"/></mxCell><mxCell id="ll_crm" value="CRM" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="60" width="150" height="932" as="geometry"/></mxCell><mxCell id="ll_vs" value="Verification svc" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="610" y="60" width="150" height="932" as="geometry"/></mxCell><mxCell id="ll_vg" value="Voice gateway&lt;br&gt;(AudioConnector)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="60" width="150" height="932" as="geometry"/></mxCell><mxCell id="ll_gx" value="Genesys&lt;br&gt;(Architect · IVR)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="230" y="60" width="150" height="932" as="geometry"/></mxCell><mxCell id="ll_c" value="Caller" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="150" height="932" as="geometry"/></mxCell><mxCell id="c1" value="B3 · Voice 'login' — Genesys collects OTP + date of birth in a secure flow → IdP issues a short-lived access token" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1" ><mxGeometry x="40" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c2" value="inbound call (recording notice played by Genesys)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" ><mxGeometry relative="1" as="geometry"><mxPoint x="115.0" y="182" as="sourcePoint"/><mxPoint x="305.0" y="182" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c3" value="AudioConnector session open (inputVariables: conversationId, ANI) · signed handshake" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" ><mxGeometry relative="1" as="geometry"><mxPoint x="305.0" y="224" as="sourcePoint"/><mxPoint x="495.0" y="224" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c4" value="prefetch by ANI: risk + language only (never spoken)" style="html=1;align=left;spacingLeft=44;fontSize=10;endArrow=block;" edge="1" parent="1" ><mxGeometry relative="1" as="geometry"><mxPoint x="495.0" y="266" as="sourcePoint"/><mxPoint x="495.0" y="284" as="targetPoint"/><Array as="points"><mxPoint x="535.0" y="266"/><mxPoint x="535.0" y="284"/></Array></mxGeometry></mxCell><mxCell id="c5" value="Caller asks about own account → personal data needed → AI ends the session with outputVariables {next: verify}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontSize=10;align=center;" vertex="1" parent="1" ><mxGeometry x="40" y="290" width="530" height="36" as="geometry"/></mxCell><mxCell id="c6" value="close session · outputVariables {next: verify}" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;dashed=1;" edge="1" parent="1" ><mxGeometry relative="1" as="geometry"><mxPoint x="495.0" y="368" as="sourcePoint"/><mxPoint x="305.0" y="368" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c7" value="Data Action: start verification (ANI)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" ><mxGeometry relative="1" as="geometry"><mxPoint x="305.0" y="410" as="sourcePoint"/><mxPoint x="685.0" y="410" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="lookup customer by registered mobile" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" ><mxGeometry relative="1" as="geometry"><mxPoint x="685.0" y="452" as="sourcePoint"/><mxPoint x="875.0" y="452" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value="customer C-88231 (candidate)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;dashed=1;" edge="1" parent="1" ><mxGeometry relative="1" as="geometry"><mxPoint x="875.0" y="494" as="sourcePoint"/><mxPoint x="685.0" y="494" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="OTP to the REGISTERED mobile only (rate-limited)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" ><mxGeometry relative="1" as="geometry"><mxPoint x="685.0" y="536" as="sourcePoint"/><mxPoint x="1065.0" y="536" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="DTMF (secure flow): OTP# + DOB#" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" ><mxGeometry relative="1" as="geometry"><mxPoint x="115.0" y="578" as="sourcePoint"/><mxPoint x="305.0" y="578" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="Data Action: verify (OTP, DOB) — not recorded, never to STT / LLM" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" ><mxGeometry relative="1" as="geometry"><mxPoint x="305.0" y="620" as="sourcePoint"/><mxPoint x="685.0" y="620" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="OTP 5 min, single use, bound to conversationId; DOB; max 3 attempts" style="html=1;align=left;spacingLeft=44;fontSize=10;endArrow=block;" edge="1" parent="1" ><mxGeometry relative="1" as="geometry"><mxPoint x="685.0" y="662" as="sourcePoint"/><mxPoint x="685.0" y="680" as="targetPoint"/><Array as="points"><mxPoint x="725.0" y="662"/><mxPoint x="725.0" y="680"/></Array></mxGeometry></mxCell><mxCell id="c14" value="token exchange (verification-svc client creds + verified assertion)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" ><mxGeometry relative="1" as="geometry"><mxPoint x="685.0" y="714" as="sourcePoint"/><mxPoint x="1255.0" y="714" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="access_token: customer_no, acr=voice_otp_dob, 15 min, no refresh" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;dashed=1;" edge="1" parent="1" ><mxGeometry relative="1" as="geometry"><mxPoint x="1255.0" y="756" as="sourcePoint"/><mxPoint x="685.0" y="756" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="store token, TTL = expiry" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" ><mxGeometry relative="1" as="geometry"><mxPoint x="685.0" y="798" as="sourcePoint"/><mxPoint x="1445.0" y="798" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="auth_ref (opaque) — or generic failure → ACD queue" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;dashed=1;" edge="1" parent="1" ><mxGeometry relative="1" as="geometry"><mxPoint x="685.0" y="840" as="sourcePoint"/><mxPoint x="305.0" y="840" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="re-open AudioConnector (inputVariables: auth_ref)" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" ><mxGeometry relative="1" as="geometry"><mxPoint x="305.0" y="882" as="sourcePoint"/><mxPoint x="495.0" y="882" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="End of call → delete token. Failure messages never reveal which factor failed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontSize=10;align=center;" vertex="1" parent="1" ><mxGeometry x="420" y="896" width="1100" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
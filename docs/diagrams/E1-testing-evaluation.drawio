<mxfile host="drawio"><diagram name="E1 Testing and Evaluation" id="d1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="E1 · Testing and evaluation system — what we test, how, how it is scored, when it gates" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1" ><mxGeometry x="40" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Test suites (kept separate — safety failures must not be averaged away)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;opacity=60;" vertex="1" parent="1" ><mxGeometry x="20" y="50" width="1860" height="200" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Golden set&lt;/b&gt; (capability)&lt;br&gt;historical cases, stratified + risk-weighted&lt;br&gt;multi-turn scenarios · voice audio&lt;br&gt;gate: thresholds, no regression" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="50" y="90" width="400" height="120" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Boundary &amp; guardrail suite&lt;/b&gt; (safety)&lt;br&gt;scope · actions · identity · data&lt;br&gt;prompt injection (direct, indirect, tool, RAG,&lt;br&gt;multi-turn, Cantonese / encoding)&lt;br&gt;gate: zero tolerance on critical" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="500" y="85" width="430" height="130" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Resilience suite&lt;/b&gt;&lt;br&gt;timeouts · core-API failures · GPU loss&lt;br&gt;limits (time, questions, steps, budget)&lt;br&gt;gate: correct degradation, never fabricate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="980" y="90" width="400" height="120" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Red team&lt;/b&gt;&lt;br&gt;security team + external (major releases)&lt;br&gt;tools: promptfoo · garak · PyRIT&lt;br&gt;every finding → automated regression" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1430" y="90" width="420" height="120" as="geometry"/></mxCell><mxCell id="c7" value="new cases" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1640" y="235"/><mxPoint x="865" y="235"/></Array></mxGeometry></mxCell><mxCell id="c8" value="Test layers" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;opacity=60;" vertex="1" parent="1" ><mxGeometry x="20" y="270" width="900" height="420" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Component&lt;/b&gt; — router accuracy · Recall@5 / MRR · reranker · citation-checker FP/FN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="50" y="310" width="840" height="55" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Trajectory&lt;/b&gt; — tool choice · arguments · steps · auth step taken vs expected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="50" y="380" width="840" height="55" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;E2E conversation (scenario-based)&lt;/b&gt; — LLM user simulator follows a script:&lt;br&gt;persona (elderly, angry, code-switching) · goal · journey · interruptions · cross-channel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="50" y="450" width="840" height="70" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Channel&lt;/b&gt; — voice: Genesys test org / SIP simulator, real anonymised recordings,&lt;br&gt;TTS + noise, DTMF, barge-in, CER, end-of-speech → first-audio latency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="50" y="535" width="840" height="70" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;System&lt;/b&gt; — peak load (120 calls + 400 chats) · fault injection · failover" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="50" y="620" width="840" height="55" as="geometry"/></mxCell><mxCell id="c14" value="Scoring" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;opacity=60;" vertex="1" parent="1" ><mxGeometry x="940" y="270" width="940" height="420" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;1 · Rule-eval service&lt;/b&gt; (deterministic, preferred)&lt;br&gt;tool called · args · auth level · cited clause ids + version&lt;br&gt;forbidden phrases · disclaimer · PII · language · voice length" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="970" y="310" width="880" height="85" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;2 · LLM-as-judge in Langfuse&lt;/b&gt; (semantic)&lt;br&gt;one criterion per judge · pass/fail or 3-point · reasoning first&lt;br&gt;structured output · reference answer when available&lt;br&gt;judge ≠ generator model · position swap · via our model gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="970" y="410" width="880" height="110" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;3 · Human review&lt;/b&gt; — calibrate judges (κ ≥ 0.8 on ~200 labelled cases)&lt;br&gt;monthly drift re-check · disputed / low-score cases · release sample" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="970" y="535" width="880" height="70" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Metrics&lt;/b&gt; — task success · containment · correct handoff · citation accuracy · hallucination rate&lt;br&gt;violations (= 0) · voice P95 latency · cost per conversation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="970" y="620" width="880" height="55" as="geometry"/></mxCell><mxCell id="c19" value="Environment" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;opacity=60;" vertex="1" parent="1" ><mxGeometry x="20" y="710" width="900" height="120" as="geometry"/></mxCell><mxCell id="c20" value="mock account / case APIs&lt;br&gt;with synthetic customers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="50" y="750" width="200" height="60" as="geometry"/></mxCell><mxCell id="c21" value="sandbox IdP&lt;br&gt;test roles + assurance levels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="270" y="750" width="200" height="60" as="geometry"/></mxCell><mxCell id="c22" value="Genesys test org&lt;br&gt;/ SIP simulator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="490" y="750" width="190" height="60" as="geometry"/></mxCell><mxCell id="c23" value="fixed seeds · temperature&lt;br&gt;pinned release bundle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="700" y="750" width="200" height="60" as="geometry"/></mxCell><mxCell id="c24" value="Cadence and gates" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;opacity=60;" vertex="1" parent="1" ><mxGeometry x="940" y="710" width="940" height="250" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Every PR&lt;/b&gt; — component tests + fast golden subset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="970" y="745" width="880" height="35" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Nightly&lt;/b&gt; — full E2E scenarios + boundary + resilience suites" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="970" y="787" width="880" height="35" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Pre-release&lt;/b&gt; — everything + red-team regression + human sample + compliance sign-off" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="970" y="829" width="880" height="35" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Canary&lt;/b&gt; — online judges + rules, new vs old version in Langfuse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="970" y="871" width="880" height="35" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Weekly&lt;/b&gt; — production sampling → annotation queue → new cases into the suites" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="970" y="913" width="880" height="35" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
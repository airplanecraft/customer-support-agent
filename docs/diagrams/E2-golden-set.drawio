<mxfile host="drawio"><diagram name="E2 Golden Set Construction" id="d1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="E2 · Building the golden set from historical customer-service interactions" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1" ><mxGeometry x="40" y="10" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;1 · Sources&lt;/b&gt;&lt;br&gt;chat logs · call transcripts&lt;br&gt;CRM contact reasons&lt;br&gt;complaints · escalations&lt;br&gt;repeat contacts · past bad answers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="40" y="80" width="230" height="120" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;2 · Legal basis + anonymisation&lt;/b&gt;&lt;br&gt;compliance approval (PDPO purpose)&lt;br&gt;pseudonymise customers&lt;br&gt;redact HKID / DOB / accounts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="310" y="85" width="230" height="110" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;3 · Taxonomy&lt;/b&gt;&lt;br&gt;intent × channel × language&lt;br&gt;× product line × clause version&lt;br&gt;× difficulty" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="580" y="85" width="230" height="110" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;4 · Risk-weighted stratified sampling&lt;/b&gt;&lt;br&gt;min ≥ 20 per intent per channel&lt;br&gt;oversample cases, eligibility,&lt;br&gt;changes, complaints&lt;br&gt;MVP ~300 → 1,000–2,000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="850" y="75" width="230" height="130" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;5 · Turn into scenarios&lt;/b&gt;&lt;br&gt;multi-turn scripts + persona + goal&lt;br&gt;voice: anonymised audio,&lt;br&gt;TTS + noise, DTMF steps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1120" y="85" width="230" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;6 · Label expected behaviour&lt;/b&gt;&lt;br&gt;intents · route / worker · tools + args&lt;br&gt;auth level · clause ids + version&lt;br&gt;answer / refuse / handoff&lt;br&gt;must-say / must-not-say" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1390" y="75" width="230" height="130" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;7 · Quality&lt;/b&gt;&lt;br&gt;senior CS + compliance&lt;br&gt;double annotation · κ&lt;br&gt;adjudicate disagreements&lt;br&gt;32B pre-labels, humans correct" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1390" y="330" width="230" height="130" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;8 · Freeze + version&lt;/b&gt;&lt;br&gt;datasets/ in Git&lt;br&gt;holdout split never used&lt;br&gt;for prompt tuning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1120" y="340" width="230" height="110" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;9 · Sync to Langfuse&lt;/b&gt;&lt;br&gt;datasets for experiments&lt;br&gt;(CI pipeline only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="850" y="345" width="230" height="100" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;10 · Refresh&lt;/b&gt;&lt;br&gt;quarterly re-sample&lt;br&gt;weekly bad cases from&lt;br&gt;the annotation queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="580" y="345" width="230" height="100" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="re-sample" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="Label the expected behaviour, not just the answer: a correct answer reached by the wrong tool,&lt;br&gt;or without the identity check, is still a failure in regulated." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1" ><mxGeometry x="40" y="500" width="760" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
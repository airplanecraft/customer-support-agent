<mxfile host="drawio"><diagram name="F1 Degradation Levels" id="d1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="F1 · Degradation levels and kill switches — fail closed for identity and writes, degrade for reads" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1" ><mxGeometry x="40" y="10" width="1400" height="30" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Level 0 · Normal&lt;/b&gt;&lt;br&gt;&lt;br&gt;all channels, intents and tools&lt;br&gt;full models (32B / 8B)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="40" y="80" width="400" height="190" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Enter when&lt;/b&gt;&lt;br&gt;—" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontSize=11;" vertex="1" parent="1" ><mxGeometry x="40" y="300" width="400" height="90" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Level 1 · Reduced&lt;/b&gt;&lt;br&gt;&lt;br&gt;smaller models (8B / 30B-A3B)&lt;br&gt;shorter voice answers&lt;br&gt;some intents go straight to humans" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="500" y="80" width="400" height="190" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Enter when&lt;/b&gt;&lt;br&gt;GPU short · latency over budget ·&lt;br&gt;Bailian rate-limited · TTS on backup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontSize=11;" vertex="1" parent="1" ><mxGeometry x="500" y="300" width="400" height="90" as="geometry"/></mxCell><mxCell id="c6" value="worse" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="&lt;b&gt;Level 2 · Safe mode&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;RAG answers only&lt;/b&gt;&lt;br&gt;no tool calls, no writes&lt;br&gt;personal-data intents → handoff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="960" y="80" width="400" height="190" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Enter when&lt;/b&gt;&lt;br&gt;IdP / STS down · core systems down ·&lt;br&gt;Redis-sec down · checkpoint writes failing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontSize=11;" vertex="1" parent="1" ><mxGeometry x="960" y="300" width="400" height="90" as="geometry"/></mxCell><mxCell id="c9" value="worse" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="&lt;b&gt;Level 3 · AI off&lt;/b&gt;&lt;br&gt;&lt;br&gt;everything to humans&lt;br&gt;voice → IVR menu / ACD&lt;br&gt;chat → human queue or message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1420" y="80" width="400" height="190" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Enter when&lt;/b&gt;&lt;br&gt;severe incident · bad release not&lt;br&gt;rolling back · compliance pause" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontSize=11;" vertex="1" parent="1" ><mxGeometry x="1420" y="300" width="400" height="90" as="geometry"/></mxCell><mxCell id="c12" value="worse" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="Kill switches (feature flags, no redeploy, effective in seconds)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;opacity=60;" vertex="1" parent="1" ><mxGeometry x="40" y="430" width="1820" height="170" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Scope&lt;/b&gt;&lt;br&gt;per channel · per intent ·&lt;br&gt;per tool · per model alias" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="80" y="475" width="380" height="100" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Who&lt;/b&gt;&lt;br&gt;on-call SRE or compliance lead&lt;br&gt;every switch audited" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="520" y="475" width="380" height="100" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Automatic&lt;/b&gt;&lt;br&gt;IdP / STS down → level 2 for personal intents&lt;br&gt;canary red line → rollback&lt;br&gt;level 3 needs a human decision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="960" y="475" width="460" height="100" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Recovery&lt;/b&gt;&lt;br&gt;step back one level at a time&lt;br&gt;after health checks pass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1480" y="475" width="340" height="100" as="geometry"/></mxCell><mxCell id="c18" value="Principles: identity and writes fail closed · reads and caches degrade · never fabricate ·&lt;br&gt;tell the customer honestly · events via transactional outbox · unknown write outcome → reconcile, never blind retry" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1" ><mxGeometry x="40" y="630" width="1100" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
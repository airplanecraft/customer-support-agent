<mxfile host="drawio"><diagram name="G1 Guardrail Layers" id="d1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="G1 · Guardrail layers — defence in depth from request to response" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1" ><mxGeometry x="40" y="10" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Customer input&lt;br&gt;(text · transcript · DTMF · upload)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="30" y="250" width="170" height="90" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;1 · Input guard&lt;/b&gt;&lt;br&gt;&lt;br&gt;length ≤ 1,000 chars&lt;br&gt;rate limit per user / client&lt;br&gt;PII redaction before LLM &amp; logs&lt;br&gt;injection classifier&lt;br&gt;uploads: AV + CDR, clean copy only&lt;br&gt;external text = data, not instructions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="240" y="170" width="250" height="250" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;2 · Identity &amp; routing&lt;/b&gt;&lt;br&gt;&lt;br&gt;token: aud · scope · acr&lt;br&gt;role → reachable agents&lt;br&gt;auth level per intent&lt;br&gt;(verify / step-up)&lt;br&gt;tools = allowlist ∩ role&lt;br&gt;recursion_limit = 8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="530" y="170" width="250" height="250" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;3 · Retrieval guard&lt;/b&gt;&lt;br&gt;&lt;br&gt;filters built from token:&lt;br&gt;visibility by role&lt;br&gt;version by contract date&lt;br&gt;owner_id for own docs&lt;br&gt;never from the model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="820" y="170" width="250" height="250" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;4 · Tool guard&lt;/b&gt;&lt;br&gt;&lt;br&gt;token exchange (narrow aud/scope)&lt;br&gt;ownership check + RLS&lt;br&gt;draft-only write tools&lt;br&gt;idempotency keys&lt;br&gt;quote → confirm → commit&lt;br&gt;human approval (interrupt)&lt;br&gt;refunds: rules engine, original&lt;br&gt;payment method only&lt;br&gt;never: phone / bank account" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1110" y="170" width="250" height="250" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;5 · Output guard&lt;/b&gt;&lt;br&gt;&lt;br&gt;citation check (exists · retrieved · version)&lt;br&gt;faithfulness (fast 8B)&lt;br&gt;no binding commitment&lt;br&gt;disclaimer when terms are discussed&lt;br&gt;PII leak check · language match&lt;br&gt;voice ≤ 3 sentences" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1400" y="170" width="260" height="250" as="geometry"/></mxCell><mxCell id="c8" value="Answer&lt;br&gt;(streamed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1710" y="220" width="160" height="60" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Refuse · step-up · handoff&lt;/b&gt;&lt;br&gt;(generic message, logged)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="820" y="480" width="330" height="70" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#ae4132;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#ae4132;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#ae4132;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#ae4132;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#ae4132;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="Same rules, three uses (defined once in Git: evaluators/*.yaml)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;opacity=60;" vertex="1" parent="1" ><mxGeometry x="30" y="590" width="1840" height="190" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Runtime guardrails&lt;/b&gt;&lt;br&gt;blocking · fast deterministic rules&lt;br&gt;+ fast 8B checks only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="70" y="640" width="380" height="100" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Offline gates&lt;/b&gt;&lt;br&gt;CI runs the same rules (rule-eval service)&lt;br&gt;+ LLM judges in Langfuse experiments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="520" y="640" width="420" height="100" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Online monitoring&lt;/b&gt;&lt;br&gt;rules on 100% of traces (rule-eval service)&lt;br&gt;judges sampled in Langfuse · alerts · annotation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1010" y="640" width="440" height="100" as="geometry"/></mxCell><mxCell id="c25" value="Prefer deterministic rules; use LLM judges only where rules can't decide.&lt;br&gt;Watch false positives too — over-blocking pushes customers to humans." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1" ><mxGeometry x="1500" y="640" width="340" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
<mxfile host="drawio"><diagram name="L1 LLMOps Lifecycle" id="d1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="L1 · LLMOps lifecycle — Git → pipeline → Langfuse → release → runtime → feedback" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1" ><mxGeometry x="40" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;1 · Git (source of truth)&lt;/b&gt;&lt;br&gt;prompts · models.yaml · evaluators&lt;br&gt;judge prompts · datasets · release.yaml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="40" y="80" width="230" height="95" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;2 · Pull request&lt;/b&gt;&lt;br&gt;code review · compliance review&lt;br&gt;for wording / permissions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="300" y="80" width="230" height="95" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;3 · CI sync to Langfuse&lt;/b&gt;&lt;br&gt;new prompt versions (+ config:&lt;br&gt;model alias, params, response_format)&lt;br&gt;model defs · judges · datasets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="560" y="75" width="230" height="105" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;4 · Offline evaluation&lt;/b&gt;&lt;br&gt;Langfuse experiments: golden set,&lt;br&gt;boundary, red-team regression&lt;br&gt;judges + rule-eval service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="820" y="75" width="230" height="105" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;5 · Gates&lt;/b&gt;&lt;br&gt;thresholds from evaluators/*.yaml&lt;br&gt;zero tolerance: binding commitment,&lt;br&gt;privilege escalation, PII leak" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1080" y="75" width="230" height="105" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;6 · Sign-off&lt;/b&gt;&lt;br&gt;compliance + model risk&lt;br&gt;(new model / judge / LoRA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1340" y="80" width="230" height="95" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;7 · Release label&lt;/b&gt;&lt;br&gt;release-2026.11.3 on all&lt;br&gt;prompt / judge versions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1600" y="80" width="230" height="95" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;8 · CD deploy&lt;/b&gt;&lt;br&gt;vLLM group from registry&lt;br&gt;(weights sha256 verified, image pinned)&lt;br&gt;gateway alias → version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1600" y="330" width="230" height="105" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;9 · Canary&lt;/b&gt;&lt;br&gt;5% sticky per session / call&lt;br&gt;compare in Langfuse 24–48 h&lt;br&gt;red line → auto rollback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1340" y="330" width="230" height="105" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;10 · Production&lt;/b&gt;&lt;br&gt;move label production →&lt;br&gt;25% → 50% → 100%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1080" y="335" width="230" height="95" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;11 · Runtime&lt;/b&gt;&lt;br&gt;orchestrator reads prompts by&lt;br&gt;release label · local cache +&lt;br&gt;image-baked fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="820" y="330" width="230" height="105" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;12 · Traces&lt;/b&gt;&lt;br&gt;every LLM call → Langfuse&lt;br&gt;release · prompt · model versions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="560" y="335" width="230" height="95" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;13 · Online evaluation&lt;/b&gt;&lt;br&gt;rules: 100% (rule-eval service)&lt;br&gt;judges: sampled (Langfuse)&lt;br&gt;high-risk intents: 100%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="300" y="330" width="230" height="105" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;14 · Dashboards + alerts&lt;/b&gt;&lt;br&gt;Langfuse scores · Grafana" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="300" y="590" width="230" height="95" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;15 · Annotation queue&lt;/b&gt;&lt;br&gt;low scores, judge/rule conflicts,&lt;br&gt;complaints → human review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="40" y="590" width="230" height="95" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" sou
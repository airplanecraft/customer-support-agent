<mxfile host="drawio"><diagram name="M1 State and Memory" id="d1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="M1 · State and memory layers — what lives where, who reads it, who writes it" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1" ><mxGeometry x="40" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Short-term (per session · thread_id)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;opacity=60;" vertex="1" parent="1" ><mxGeometry x="20" y="60" width="600" height="520" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;LangGraph state&lt;/b&gt;&lt;br&gt;&lt;br&gt;messages (last N turns) · summary&lt;br&gt;channel · language&lt;br&gt;customer_id (after verification)&lt;br&gt;assurance: level · verified_at · expires_at&lt;br&gt;auth_ref (opaque)&lt;br&gt;intents · current worker&lt;br&gt;task_ids · pending draft&lt;br&gt;guard counters · release label&lt;br&gt;retrieved chunk ids (not full text)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="40" y="100" width="290" height="260" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Postgres checkpoints&lt;/b&gt;&lt;br&gt;PostgresSaver · key: thread_id&lt;br&gt;kept 30 days → archive&lt;br&gt;not the audit log" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="380" y="130" width="220" height="120" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;trim_messages + summary node&lt;/b&gt;&lt;br&gt;keep last N turns raw;&lt;br&gt;older turns → summary&lt;br&gt;(versioned prompt, via model gateway)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="40" y="400" width="290" height="110" as="geometry"/></mxCell><mxCell id="c6" value="persisted as" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;Orchestrator (LangGraph)&lt;/b&gt;&lt;br&gt;router + bounded workers&lt;br&gt;stateless pods" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="680" y="240" width="300" height="120" as="geometry"/></mxCell><mxCell id="c9" value="every step · durability=async;&lt;br&gt;sync before write tools / interrupt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="Long-term and systems of record (per customer)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;opacity=60;" vertex="1" parent="1" ><mxGeometry x="1060" y="60" width="820" height="520" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;PostgresStore + pgvector&lt;/b&gt;&lt;br&gt;('customer', cid, 'summaries')&lt;br&gt;('customer', cid, 'prefs')&lt;br&gt;TTL 90 days · delete on request" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1100" y="90" width="300" height="105" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Postgres tasks&lt;/b&gt;&lt;br&gt;open work · approvals · drafts&lt;br&gt;step-up evidence · no tokens" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1100" y="215" width="300" height="100" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Redis-sec (dedicated)&lt;/b&gt;&lt;br&gt;token store: auth_ref → encrypted token&lt;br&gt;TTL ≤ token expiry · deleted at session end" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1100" y="335" width="300" height="100" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Systems of record&lt;/b&gt;&lt;br&gt;accounts · billing · cases&lt;br&gt;via internal API gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1100" y="455" width="300" height="95" as="geometry"/></mxCell><mxCell id="c15" value="after verification: search(limit=3) + prefs&lt;br&gt;namespace from token sub, never the LLM" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="open tasks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.37;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="resolve auth_ref" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.63;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="facts: always read live" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="&lt;b&gt;Memory = hints. Systems of record = facts.&lt;/b&gt;&lt;br&gt;Address, balances, contract status are never&lt;br&gt;memory — read live every time.&lt;br&gt;Open work lives in tasks, not memory." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1" ><mxGeometry x="1440" y="90" width="420" height="105" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Never in state, checkpoints or memory&lt;/b&gt;&lt;br&gt;tokens · OTP · raw audio · full ID or card numbers&lt;br&gt;Memory loads only after verification;&lt;br&gt;voice prefetches it while verification runs." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1" ><mxGeometry x="1440" y="215" width="420" height="105" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Governance&lt;/b&gt;&lt;br&gt;customer deletion → drop the namespace&lt;br&gt;TTL sweep for expired entries&lt;br&gt;each memory traceable to session + prompt version" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1" ><mxGeometry x="1440" y="340" width="420" height="95" as="geometry"/></mxCell><mxCell id="c22" value="Why not LangMem: no in-conversation memory writes&lt;br&gt;(persistent prompt injection),&lt;br&gt;no free-form fact extraction,&lt;br&gt;LLM calls must go through our gateway." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1" ><mxGeometry x="740" y="430" width="250" height="120" as="geometry"/></mxCell><mxCell id="c23" value="Long-term write path (background, off the hot path)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;opacity=60;" vertex="1" parent="1" ><mxGeometry x="20" y="620" width="1860" height="300" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Kafka&lt;/b&gt;&lt;br&gt;session.ended" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="50" y="720" width="200" height="90" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;MemoryWriter worker&lt;/b&gt;&lt;br&gt;reads the interaction record&lt;br&gt;(intent, outcome, task ids)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="310" y="720" width="240" height="90" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Model gateway&lt;/b&gt;&lt;br&gt;summary prompt vN (Git → Langfuse)&lt;br&gt;fixed schema via response_format" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="610" y="720" width="260" height="90" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Output guardrail&lt;/b&gt;&lt;br&gt;PII redaction · drop identity /&lt;br&gt;authorization claims" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="930" y="720" width="240" height="90" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Store.put&lt;/b&gt;&lt;br&gt;namespace from customer_id&lt;br&gt;TTL 90 days" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1230" y="720" width="220" height="90" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Audit&lt;/b&gt;&lt;br&gt;memory ↔ session ↔&lt;br&gt;prompt version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1510" y="720" width="220" height="90" as="geometry"/></mxCell><mxCell id="c30" value="session.ended" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.12;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="716" y="670"/><mxPoint x="150" y="670"/></Array></mxGeometry></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c28" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
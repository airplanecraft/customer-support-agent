<mxfile host="drawio"><diagram name="P1 Deployment Profiles" id="d1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="P1 · Deployment profiles — same core, two ways to run it (pick one per client; never mix on the voice path)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1" ><mxGeometry x="40" y="10" width="1400" height="30" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Shared core (identical in both profiles)&lt;/b&gt;&lt;br&gt;orchestrator (LangGraph) · RAG service · MCP tools · guardrails · model gateway · voice gateway&lt;br&gt;evaluation + LLMOps (Git → pipeline → Langfuse) · same prompts, evaluators, datasets, release bundle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="450" y="60" width="1000" height="80" as="geometry"/></mxCell><mxCell id="c3" value="Cloud profile — all in the region profile's cloud region (data stays in that region)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;opacity=60;" vertex="1" parent="1" ><mxGeometry x="40" y="180" width="880" height="470" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Telephony&lt;/b&gt;&lt;br&gt;Genesys Cloud CX (resident in the same region)&lt;br&gt;IVR · ACD · AudioConnector · secure DTMF flows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="80" y="230" width="800" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Speech&lt;/b&gt;&lt;br&gt;Alibaba Cloud Model Studio (Bailian): Paraformer realtime (STT) · CosyVoice (TTS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="80" y="320" width="800" height="60" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;LLM / embedding / rerank&lt;/b&gt;&lt;br&gt;Bailian Qwen3 + Qwen3-Embedding / Reranker, or vLLM in the client's Alibaba Cloud VPC in that region" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="80" y="400" width="800" height="60" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Platform&lt;/b&gt;&lt;br&gt;ACK (Kubernetes) · ApsaraDB (Postgres) · Redis · Milvus / AnalyticDB vector · OSS · Kafka" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="80" y="480" width="800" height="60" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Connectivity&lt;/b&gt;&lt;br&gt;private links (Express Connect / VPN) to the client's core systems and IdP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="80" y="560" width="800" height="60" as="geometry"/></mxCell><mxCell id="c9" value="On-prem profile — everything in the client's data centre" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;opacity=60;" vertex="1" parent="1" ><mxGeometry x="980" y="180" width="880" height="470" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Telephony&lt;/b&gt;&lt;br&gt;Genesys Engage (on-prem) · SIP / AudioConnector-equivalent integration&lt;br&gt;IVR · ACD · secure DTMF flows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1020" y="230" width="800" height="70" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Speech&lt;/b&gt;&lt;br&gt;open-source Alibaba Tongyi models, self-hosted: FunASR / SenseVoice (STT) · CosyVoice 2 (TTS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1020" y="320" width="800" height="60" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;LLM / embedding / rerank&lt;/b&gt;&lt;br&gt;Qwen3-32B / 8B on vLLM · Qwen3-Embedding / Reranker (open weights) on the GPU pool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1020" y="400" width="800" height="60" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Platform&lt;/b&gt;&lt;br&gt;on-prem Kubernetes (CPU + GPU pools) · Postgres · Redis · Milvus · object storage · Kafka" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1020" y="480" width="800" height="60" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Connectivity&lt;/b&gt;&lt;br&gt;internal network to core systems and IdP · no internet dependency on the voice path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="1020" y="560" width="800" height="60" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;Why not mix?&lt;/b&gt; Voice is latency-critical: Genesys → voice gateway → STT → LLM → TTS → back.&lt;br&gt;Every network hop (e.g. on-prem gateway ↔ cloud speech ↔ on-prem LLM) adds round trips and failure points,&lt;br&gt;and breaks the ~1 s budget. Keep the whole voice path inside one network." style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1" ><mxGeometry x="40" y="680" width="880" height="80" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Choosing a profile (with the client's compliance team, week one)&lt;/b&gt;&lt;br&gt;• data residency and outsourcing / cloud requirements (sector-regulator guidelines, PDPO)&lt;br&gt;• contracts: DPA, no training on customer data, retention, sub-processors&lt;br&gt;• existing estate: Genesys Cloud vs Engage, Alibaba Cloud footprint, GPU capacity&lt;br&gt;• cost: managed APIs (pay per use) vs GPUs (capex, DR doubles them)" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1" ><mxGeometry x="980" y="680" width="880" height="110" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Local development (not a deployment profile)&lt;/b&gt;&lt;br&gt;laptop: Ollama serves Qwen3-8B (quantised) through an OpenAI-compatible API · Zvec as an embedded vector store (dense + full-text, jieba)&lt;br&gt;same application code via the model gateway · release evaluations always run on the production model (vLLM or Bailian)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1" ><mxGeometry x="40" y="820" width="1820" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>